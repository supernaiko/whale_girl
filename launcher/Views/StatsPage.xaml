<UserControl x:Class="WhaleLauncher.Views.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" UseLayoutRounding="True">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TodayButton" Content="今天" Tag="1" Style="{StaticResource Ghost}"
                        Padding="12,7" Click="OnRange" />
                <Button x:Name="WeekButton" Content="7 天" Tag="7" Style="{StaticResource Primary}"
                        Padding="12,7" Margin="6,0,0,0" Click="OnRange" />
                <Button x:Name="MonthButton" Content="30 天" Tag="30" Style="{StaticResource Ghost}"
                        Padding="12,7" Margin="6,0,0,0" Click="OnRange" />
                <Button x:Name="YearButton" Content="一年" Tag="365" Style="{StaticResource Ghost}"
                        Padding="12,7" Margin="6,0,0,0" Click="OnRange" />
                <Button x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                        Margin="14,0,0,0" Click="OnRefresh" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Text="统计" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <TextBlock x:Name="UpdatedText" DockPanel.Dock="Left" Text="—" Style="{StaticResource Small}"
                       Foreground="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Small}" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

                <UniformGrid Columns="6" Margin="0,0,0,14">
                    <Border Style="{StaticResource Card}" Padding="10,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="请求数" Style="{StaticResource Label}" />
                            <TextBlock x:Name="RequestsText" Text="—" Style="{StaticResource H2}" FontSize="18"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="10,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="计费 token" Style="{StaticResource Label}" />
                            <TextBlock x:Name="TokensText" Text="—" Style="{StaticResource H2}" FontSize="18"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="10,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="预估花费" Style="{StaticResource Label}" />
                            <TextBlock x:Name="CostText" Text="—" Style="{StaticResource H2}" FontSize="18"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="10,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="缓存命中率" Style="{StaticResource Label}" />
                            <TextBlock x:Name="CacheText" Text="—" Style="{StaticResource H2}" FontSize="18"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="10,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="消息数" Style="{StaticResource Label}" />
                            <TextBlock x:Name="MessagesText" Text="—" Style="{StaticResource H2}" FontSize="18"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="10,10">
                        <StackPanel>
                            <TextBlock Text="平均回复字数" Style="{StaticResource Label}" />
                            <TextBlock x:Name="ReplyLengthText" Text="—" Style="{StaticResource H2}" FontSize="18"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="最近 7 天" Style="{StaticResource H2}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Accent}" />
                                <TextBlock Text="计费 token" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" Margin="5,0,14,0" />
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Ok}" />
                                <TextBlock Text="预估花费" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" Margin="5,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid x:Name="DailyChart" Height="118" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="活跃时段" DockPanel.Dock="Left" Style="{StaticResource H2}" />
                            <TextBlock Text="模型请求 · 北京时间" DockPanel.Dock="Right" Style="{StaticResource Small}"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid x:Name="Heatmap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="会话" Style="{StaticResource H2}" Margin="0,0,0,8" />
                <TextBlock x:Name="ChatsEmpty" Style="{StaticResource Small}" Foreground="{StaticResource Muted}"
                           Margin="0,0,0,8" Visibility="Collapsed" Text="这段时间没有会话消息。" />
                <ItemsControl x:Name="ChatsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource Text}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Messages}" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Split}" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Average}" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="4" Text="{Binding LastActive}" Style="{StaticResource Small}" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="数据来自本机用量日志（usage.jsonl 及轮转文件）和聊天记忆（memory），按北京时间统计。"
                           Style="{StaticResource Small}" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
