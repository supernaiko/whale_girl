<UserControl x:Class="WhaleLauncher.Views.PanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left" Text="数据面板" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <TextBlock x:Name="UpdatedText" DockPanel.Dock="Left" Style="{StaticResource Small}"
                       Margin="14,0,0,0" VerticalAlignment="Center" Text="—" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" Click="OnRefreshClick" />
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="Tabs" Background="Transparent" BorderThickness="0">
        <TabItem Header="概览">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,6,0">
            <StackPanel>

                <!-- 四个数字 -->
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="今天请求" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="KpiToday" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                            <TextBlock x:Name="KpiTodaySub" Text="" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="近 7 天消息" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="KpiWeek" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                            <TextBlock x:Name="KpiWeekSub" Text="" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="今天花费" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="KpiCost" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            <TextBlock x:Name="KpiCostSub" Text="" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="她此刻" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="KpiMood" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Ok}" />
                            <TextBlock x:Name="KpiMoodSub" Text="" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 心情 -->
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="心情" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,10,4" />
                                    <TextBlock x:Name="MoodLabel" DockPanel.Dock="Left" Text="—" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text}" />
                                </DockPanel>
                                <TextBlock x:Name="MoodWhy" Style="{StaticResource Small}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="心情" Style="{StaticResource Small}" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="ValenceText" DockPanel.Dock="Right" Style="{StaticResource Small}" Text="—" />
                                </DockPanel>
                                <ProgressBar x:Name="ValenceBar" Height="6" Minimum="0" Maximum="100" Margin="0,4,0,10"
                                             Foreground="{StaticResource Accent}" Background="{StaticResource Surface3}" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="精力" Style="{StaticResource Small}" Foreground="{StaticResource Ok}" />
                                    <TextBlock x:Name="EnergyText" DockPanel.Dock="Right" Style="{StaticResource Small}" Text="—" />
                                </DockPanel>
                                <ProgressBar x:Name="EnergyBar" Height="6" Minimum="0" Maximum="100" Margin="0,4,0,0"
                                             Foreground="{StaticResource Ok}" Background="{StaticResource Surface3}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="最近 24 小时" Style="{StaticResource Small}"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="HistoryHint" DockPanel.Dock="Right" Style="{StaticResource Small}"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Canvas x:Name="HistoryCanvas" Grid.Row="1" Height="86" Margin="0,6,0,0" ClipToBounds="True" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 花销 + 统计 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18" Margin="0,0,10,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="花销" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="今日" Tag="1" Style="{StaticResource Ghost}" Margin="0,0,6,0" Click="OnCostRange" />
                                    <Button Content="7 天" Tag="7" Style="{StaticResource Ghost}" Margin="0,0,6,0" Click="OnCostRange" />
                                    <Button Content="30 天" Tag="30" Style="{StaticResource Ghost}" Click="OnCostRange" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="CostTotal" Text="—" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}" Margin="0,12,0,0" />
                            <TextBlock x:Name="CostHint" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" />
                            <Canvas x:Name="CostCanvas" Height="92" Margin="0,12,0,0" ClipToBounds="True" />
                            <TextBlock x:Name="CostPeak" Style="{StaticResource Small}" Foreground="{StaticResource Muted}"
                                       Margin="0,8,0,0" Text="—" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18">
                        <StackPanel>
                            <TextBlock Text="聊天统计" Style="{StaticResource H2}" />
                            <TextBlock x:Name="StatsHint" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" Text="—" />
                            <Canvas x:Name="StatsCanvas" Height="92" Margin="0,12,0,0" ClipToBounds="True" />
                            <ItemsControl x:Name="ChatList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Small}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Header="心情" x:Name="TabMood" />
        <TabItem Header="花销" x:Name="TabCost" />
        <TabItem Header="统计" x:Name="TabStats" />
        </TabControl>
    </Grid>
</UserControl>
