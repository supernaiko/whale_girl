<UserControl x:Class="WhaleLauncher.Views.PanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="OverviewMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="OverviewMetricDetail" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="ChatNumber" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left" Text="数据面板" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <TextBlock x:Name="UpdatedText" DockPanel.Dock="Left" Style="{StaticResource Small}"
                       Margin="14,0,0,0" VerticalAlignment="Center" Text="—" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" Click="OnRefreshClick" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                <Button Content="7 天" Tag="7" Style="{StaticResource Ghost}" Margin="0,0,6,0" Click="OnInsightRange" />
                <Button Content="30 天" Tag="30" Style="{StaticResource Ghost}" Margin="0,0,6,0" Click="OnInsightRange" />
                <Button Content="一年" Tag="365" Style="{StaticResource Ghost}" Click="OnInsightRange" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="Tabs" Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource DarkTabItem}" Padding="0">
        <TabItem Header="概览">
        <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" Padding="0,14,6,0">
            <StackPanel>

                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="今天的她" Style="{StaticResource H2}" />
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="当前心情" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="KpiMood" Text="—" Style="{StaticResource OverviewMetricValue}"
                                               Foreground="{DynamicResource Ok}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <TextBlock x:Name="KpiMoodSub" Text="正在读取心情" Style="{StaticResource OverviewMetricDetail}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="模型请求" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="KpiToday" Text="—" Style="{StaticResource OverviewMetricValue}" />
                                    <TextBlock Text="DeepSeek 调用次数" Style="{StaticResource OverviewMetricDetail}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="近 7 天" Style="{StaticResource H2}" />
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="消息数" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="KpiWeek" Text="—" Style="{StaticResource OverviewMetricValue}" />
                                    <TextBlock x:Name="KpiWeekSub" Text="包含双方消息" Style="{StaticResource OverviewMetricDetail}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="计费 token" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="KpiWeekTokens" Text="—" Style="{StaticResource OverviewMetricValue}"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <TextBlock x:Name="KpiWeekTokensSub" Text="输入与输出合计" Style="{StaticResource OverviewMetricDetail}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="花费" Style="{StaticResource H2}" />
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="今日" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="KpiCost" Text="—" Style="{StaticResource OverviewMetricValue}"
                                               Foreground="{DynamicResource Accent}" />
                                    <TextBlock x:Name="KpiCostSub" Text="DeepSeek 预估" Style="{StaticResource OverviewMetricDetail}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="所选时段" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="KpiCostRange" Text="—" Style="{StaticResource OverviewMetricValue}"
                                               Foreground="{DynamicResource Accent}" />
                                    <TextBlock x:Name="KpiCostRangeSub" Text="近 7 天" Style="{StaticResource OverviewMetricDetail}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="会话明细" Style="{StaticResource H2}" />
                            <TextBlock x:Name="ChatDetailsHint" DockPanel.Dock="Right" Text="正在读取近 7 天会话…"
                                       Style="{StaticResource Small}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel x:Name="ChatDetailsRows" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid Margin="0,0,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="会话" Style="{StaticResource Small}" />
                                <TextBlock Grid.Column="1" Text="消息数" Style="{StaticResource Small}" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="token" Style="{StaticResource Small}" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="花费" Style="{StaticResource Small}" TextAlignment="Right" />
                                <TextBlock x:Name="ChatShareHeader" Grid.Column="4" Text="消息占比" Style="{StaticResource Small}" Margin="14,0,0,0" />
                            </Grid>
                            <ItemsControl x:Name="ChatList" MaxHeight="176" VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="True" PreviewMouseWheel="OnChatListMouseWheel">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,6"
                                                ToolTip="{Binding Details}" ToolTipService.InitialShowDelay="150">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="108" />
                                                    <ColumnDefinition Width="176" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Foreground="{DynamicResource Text}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Messages}" Style="{StaticResource ChatNumber}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Tokens}" Style="{StaticResource ChatNumber}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Cost}" Style="{StaticResource ChatNumber}" />
                                                <Grid Grid.Column="4" Margin="14,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Height="5" Maximum="1" Value="{Binding Share, Mode=OneWay}"
                                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface3}"
                                                                 VerticalAlignment="Center">
                                                        <ProgressBar.Template>
                                                            <ControlTemplate TargetType="ProgressBar">
                                                                <Grid x:Name="PART_Track" ClipToBounds="True">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                                                            HorizontalAlignment="Left" CornerRadius="2" />
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </ProgressBar.Template>
                                                    </ProgressBar>
                                                    <TextBlock Grid.Column="1" Text="{Binding ShareLabel}" Style="{StaticResource ChatNumber}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 心情 -->
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="心情" Style="{StaticResource Label}"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,10,4" />
                                    <TextBlock x:Name="MoodLabel" DockPanel.Dock="Left" Text="—" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text}" />
                                </DockPanel>
                                <TextBlock x:Name="MoodWhy" Style="{StaticResource Small}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="心情" Style="{StaticResource Small}" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="ValenceText" DockPanel.Dock="Right" Style="{StaticResource Small}" Text="—" />
                                </DockPanel>
                                <ProgressBar x:Name="ValenceBar" Height="6" Minimum="0" Maximum="100" Margin="0,4,0,10"
                                             Foreground="{StaticResource Accent}" Background="{StaticResource Surface3}" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="精力" Style="{StaticResource Small}" Foreground="{StaticResource Ok}" />
                                    <TextBlock x:Name="EnergyText" DockPanel.Dock="Right" Style="{StaticResource Small}" Text="—" />
                                </DockPanel>
                                <ProgressBar x:Name="EnergyBar" Height="6" Minimum="0" Maximum="100" Margin="0,4,0,0"
                                             Foreground="{StaticResource Ok}" Background="{StaticResource Surface3}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="最近 24 小时" Style="{StaticResource Small}"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="HistoryHint" DockPanel.Dock="Right" Style="{StaticResource Small}"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Canvas x:Name="HistoryCanvas" Grid.Row="1" Height="86" Margin="0,6,0,0" ClipToBounds="True" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="记忆变化" Style="{StaticResource H2}" />
                            <TextBlock x:Name="MemoryHint" Text="正在读取记忆记录…" Style="{StaticResource Small}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Canvas x:Name="MemoryCanvas" Height="104" Margin="0,12,0,0"
                                    ClipToBounds="True" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18">
                        <StackPanel>
                            <TextBlock Text="聊天量" Style="{StaticResource H2}" />
                            <TextBlock x:Name="ChatTrendHint" Text="正在读取聊天记录…" Style="{StaticResource Small}" Margin="0,6,0,0" />
                            <StackPanel x:Name="ChatLegend" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock Text="消息数" Style="{StaticResource Small}" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
                                <TextBlock Text="她回复数" Style="{StaticResource Small}" Foreground="{StaticResource Ok}" />
                            </StackPanel>
                            <Canvas x:Name="ChatTrendCanvas" Height="104" Margin="0,12,0,0"
                                    ClipToBounds="True" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="聊天热力图" Style="{StaticResource H2}" />
                            <TextBlock x:Name="HeatmapHint" Text="正在读取聊天记录…" Style="{StaticResource Small}" Margin="0,6,0,0" />
                            <Canvas x:Name="HeatmapCanvas" Width="328" Height="101" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18">
                        <StackPanel>
                            <TextBlock Text="心情极值" Style="{StaticResource H2}" />
                            <TextBlock x:Name="ExtremesHint" Text="正在读取心情记录…" Style="{StaticResource Small}" Margin="0,6,0,0" />
                            <StackPanel x:Name="ExtremeRows" Visibility="Collapsed">
                                <TextBlock x:Name="MoodHigh" Style="{StaticResource Small}" Margin="0,10,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="MoodLow" Style="{StaticResource Small}" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="每人好感" Style="{StaticResource H2}" />
                        <TextBlock x:Name="BondHint" Text="正在读取好感记录…" Style="{StaticResource Small}" Margin="0,6,0,0" />
                        <StackPanel x:Name="BondLegend" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                            <TextBlock Text="亲近" Style="{StaticResource Small}" Foreground="{StaticResource Accent}" Margin="0,0,12,0" />
                            <TextBlock Text="信任" Style="{StaticResource Small}" Foreground="{StaticResource Ok}" />
                        </StackPanel>
                        <StackPanel x:Name="BondRows" />
                    </StackPanel>
                </Border>

                <!-- 花销 + 统计 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18" Margin="0,0,10,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="花销" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="今日" Tag="1" Style="{StaticResource Ghost}" Margin="0,0,6,0" Click="OnCostRange" />
                                    <Button Content="7 天" Tag="7" Style="{StaticResource Ghost}" Margin="0,0,6,0" Click="OnCostRange" />
                                    <Button Content="30 天" Tag="30" Style="{StaticResource Ghost}" Click="OnCostRange" />
                                    <Button Content="一年" Tag="365" Style="{StaticResource Ghost}" Margin="6,0,0,0" Click="OnCostRange" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="CostTotal" Text="—" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}" Margin="0,12,0,0" />
                            <TextBlock x:Name="CostHint" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" />
                            <Canvas x:Name="CostCanvas" Height="92" Margin="0,12,0,0" ClipToBounds="True" />
                            <TextBlock x:Name="CostPeak" Style="{StaticResource Small}" Foreground="{StaticResource Muted}"
                                       Margin="0,8,0,0" Text="—" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18">
                        <StackPanel>
                            <TextBlock Text="聊天统计" Style="{StaticResource H2}" />
                            <TextBlock x:Name="StatsHint" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" Text="—" />
                            <Canvas x:Name="StatsCanvas" Height="92" Margin="0,12,0,0" ClipToBounds="True" />
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem Header="心情" x:Name="TabMood" />
        <TabItem Header="花销" x:Name="TabCost" />
        <TabItem Header="统计" x:Name="TabStats" />
        </TabControl>
    </Grid>
</UserControl>
