<UserControl x:Class="WhaleLauncher.Views.CodexLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="Title" Style="{StaticResource H1}" />
            <TextBlock x:Name="Hint" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,12" />
            <StackPanel Orientation="Horizontal">
                <Button Content="刷新" Padding="14,5" Click="OnRefresh" />
                <CheckBox x:Name="Follow" Content="自动跟随最新一次运行" IsChecked="True"
                          VerticalAlignment="Center" Margin="14,0,0,0" />
                <CheckBox x:Name="Raw" Content="显示原始日志" Click="OnRawChanged"
                          VerticalAlignment="Center" Margin="14,0,0,0" />
                <CheckBox x:Name="Wrap" Content="自动换行" IsChecked="True"
                          IsEnabled="{Binding IsChecked, ElementName=Raw}"
                          VerticalAlignment="Center" Margin="14,0,0,0" Click="OnWrapChanged" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="6">
                <ListBox x:Name="Runs" SelectionChanged="OnRunSelected"
                         Background="Transparent" BorderThickness="0" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="Summary" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock x:Name="TaskText" Foreground="{DynamicResource Text}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <TextBlock x:Name="CwdText" Style="{StaticResource Small}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="34"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <TextBlock x:Name="RunStats" Foreground="{DynamicResource Text2}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <ScrollViewer x:Name="StepScroller" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Steps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Foreground="{DynamicResource Text}" Margin="0,0,0,4">
                                        <Expander.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </Expander.HeaderTemplate>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Text2}"
                                                   TextWrapping="Wrap" Margin="22,4,8,7" />
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Expander">
                                                                    <ContentPresenter ContentSource="Header" Margin="22,3,0,3" />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer x:Name="RawScroller" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource Text}" TextWrapping="Wrap" LineHeight="18" />
                    </ScrollViewer>

                    <TextBlock x:Name="StatusText" Grid.Row="1" Style="{StaticResource Small}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
