<UserControl x:Class="WhaleLauncher.Views.VoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="说话方式" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <TextBlock x:Name="UpdatedText" DockPanel.Dock="Left" Style="{StaticResource Small}"
                       Margin="14,0,0,0" VerticalAlignment="Center" Text="—" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" Click="OnRefresh" />
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,16,0,0">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="样本" Style="{StaticResource Label}" />
                    <TextBlock x:Name="StatN" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,6,0,0" />
                    <TextBlock Text="句她发过的话" Style="{StaticResource Small}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="平均篇幅" Style="{StaticResource Label}" />
                    <TextBlock x:Name="StatAvg" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,6,0,0" />
                    <TextBlock Text="个字/句" Style="{StaticResource Small}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="短句" Style="{StaticResource Label}" />
                    <TextBlock x:Name="StatShort" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,6,0,0" />
                    <TextBlock Text="≤12 字" Style="{StaticResource Small}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="表情" Style="{StaticResource Label}" />
                    <TextBlock x:Name="StatEmoji" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,6,0,0" />
                    <TextBlock Text="带表情的比例" Style="{StaticResource Small}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="句号" Style="{StaticResource Label}" />
                    <TextBlock x:Name="StatPeriod" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,6,0,0" />
                    <TextBlock Text="句尾带句号" Style="{StaticResource Small}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="注入给她的那一行" Style="{StaticResource Label}" />
                <TextBlock x:Name="InjectedText" Style="{StaticResource Small}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text}" Text="样本还不够，暂时不注入。" />
                <TextBlock x:Name="OpenersText" Style="{StaticResource Small}" Margin="0,8,0,0" Text="—" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="她最近说过的" Style="{StaticResource Label}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl x:Name="SamplesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Small}" Foreground="{DynamicResource Text}"
                                           TextWrapping="Wrap" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
