<UserControl x:Class="WhaleLauncher.Views.MomentsPicsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="朋友圈调试" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <TextBlock x:Name="UpdatedText" DockPanel.Dock="Left" Style="{StaticResource Small}"
                       Margin="14,0,0,0" VerticalAlignment="Center" Text="—" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" Click="OnRefresh" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="试写一次（不发布）" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnRun" Content="▶ 跑一次" Style="{StaticResource Primary}" Click="OnRun" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="写一句你想让它发的场景，比如「今天想吃火锅」「加班到十一点」。它会先找候选图，再让 Codex 看图挑一张、写一句。" />
                <TextBox x:Name="PromptInput" Margin="0,10,0,0" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True" />
                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="搜索词（可选）" Style="{StaticResource Small}" VerticalAlignment="Center" />
                    <TextBox x:Name="QueryInput" DockPanel.Dock="Left" Width="220" Margin="10,0,0,0" />
                    <CheckBox x:Name="ChkUseSelf" DockPanel.Dock="Left" Content="带上本人图" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="RunInfo" DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center" Text="" />
                </DockPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Surface3}" CornerRadius="8" Padding="6">
                        <Image x:Name="ResultImage" Width="248" Height="248" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="文案" Style="{StaticResource Label}" />
                        <TextBox x:Name="ResultText" Margin="0,6,0,0" MinHeight="60" TextWrapping="Wrap" IsReadOnly="True" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BtnCopyText" Content="复制文案" Style="{StaticResource Ghost}" Click="OnCopyText" />
                            <Button x:Name="BtnCopyPrompt" Content="复制这次用的提示词" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnCopyUsedPrompt" />
                            <TextBlock x:Name="RunStatus" Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Center" Text="" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Expander Header="这次用的提示词 / 原始输出" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBox x:Name="UsedPrompt" Margin="0,6,0,0" MinHeight="90" TextWrapping="Wrap" IsReadOnly="True" AcceptsReturn="True" />
                        <TextBox x:Name="RawOutput" Margin="0,6,0,0" MinHeight="60" TextWrapping="Wrap" IsReadOnly="True" AcceptsReturn="True" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="她本人（只用这几张代表她，最多 6 张）" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnAdd" Content="＋ 添加图片" Style="{StaticResource Ghost}" Click="OnAdd" />
                        <Button x:Name="BtnOpenDir" Content="打开文件夹" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnOpenDir" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl x:Name="PicList" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="8">
                                <StackPanel Width="128">
                                    <Image Source="{Binding Image}" Width="112" Height="112" Stretch="UniformToFill" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Small}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                    <Button Content="移除" Style="{StaticResource Ghost}" Margin="0,6,0,0" Tag="{Binding Name}" Click="OnRemove" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource Surface3}" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="按场景让 Codex 出一张（固定人物，慢，40~90 秒）" Style="{StaticResource Label}" />
                        <TextBox x:Name="PaintScene" Margin="0,8,0,0" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="一个人在家煮了碗面，坐在小桌前吃，窗外在下雨" />
                        <DockPanel Margin="0,8,0,0" LastChildFill="False">
                            <Button x:Name="BtnPaint" Content="✎ 出图" Style="{StaticResource Primary}" Click="OnPaint" />
                            <Button x:Name="BtnUsePaint" Content="加入本人图池" Style="{StaticResource Ghost}" Margin="8,0,0,0" IsEnabled="False" Click="OnUsePaint" />
                            <TextBlock x:Name="PaintStatus" Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Center" Text="" />
                        </DockPanel>
                        <Border Background="{StaticResource Surface3}" CornerRadius="8" Margin="0,10,0,0" Padding="6" HorizontalAlignment="Left">
                            <Image x:Name="PaintPreview" Width="240" Height="320" Stretch="Uniform" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="正式发表时谁写" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox x:Name="CmbWriter" Width="180">
                            <ComboBoxItem Tag="deepseek" Content="DeepSeek（默认）" />
                            <ComboBoxItem Tag="codex" Content="Codex（看图）" />
                        </ComboBox>
                        <TextBlock Text="配图来源" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ComboBox x:Name="CmbSource" Width="180" Margin="8,0,0,0">
                            <ComboBoxItem Tag="weibo" Content="微博图（快）" />
                            <ComboBoxItem Tag="codex" Content="Codex 出图（慢，同一个人）" />
                        </ComboBox>
                        <Button x:Name="BtnSave" Content="保存" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnSave" />
                        <TextBlock x:Name="SaveText" Style="{StaticResource Small}" Margin="10,0,0,0" VerticalAlignment="Center" Text="" />
                    </StackPanel>
                </DockPanel>
                <CheckBox x:Name="ChkNoPerson" Margin="0,10,0,0" Content="配图优先选没有人的照片（食物、街景、猫、背影）" />
                <CheckBox x:Name="ChkRepeat" Margin="0,6,0,0" Content="允许重复发日常梗（饿了、困、不想上班）" />
                <TextBlock Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="出图提示词在 docs\prompts\self-photo.md：身份段固定、场景段每次换一句，出完图放进上面目录当「她本人」。" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusText" Style="{StaticResource Small}" Margin="0,10,0,0" Text="" />
    </Grid>
</UserControl>
