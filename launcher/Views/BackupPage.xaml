<UserControl x:Class="WhaleLauncher.Views.BackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="备份与迁移" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <TextBlock x:Name="DataPath" DockPanel.Dock="Left" Style="{StaticResource Small}"
                       Margin="14,0,0,0" VerticalAlignment="Center" Text="—" />
        </DockPanel>

        <!-- 导出 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="打包她现在的样子" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="人设、自定义提示词、记忆（会话/事件卡/摘要）、日记、心情与好感、表情包、语音预设、提醒。换电脑、重装、或者哪天微信不能用了，把这个 zip 放回去，她还是她。" />
                    <TextBlock x:Name="StatLine" Style="{StaticResource Small}" Margin="0,10,0,0" Text="统计中…" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0" Foreground="{DynamicResource Muted}"
                               Text="不包含：微信账号登录态、API Key、日志。这些换机器要重新登录/重填。" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="BtnExport" Content="导出备份…" Style="{StaticResource Primary}" Click="OnExport" MinWidth="140" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 恢复 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22,18" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="从备份恢复" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="选择之前导出的 zip。恢复前会自动把当前数据打包一份放到 data\\_backup\\ 下；同名文件以备份为准。恢复完请重启内核，让她重新读一遍记忆。" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="BtnImport" Content="选择备份…" Style="{StaticResource Ghost}" Click="OnImport" MinWidth="140" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="日志" Style="{StaticResource Label}" />
                    <TextBlock x:Name="LogText" Style="{StaticResource Small}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="—" Foreground="{DynamicResource Text}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
