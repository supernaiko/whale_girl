<UserControl x:Class="WhaleLauncher.Views.MoodPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="心情" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <TextBlock x:Name="UpdatedText" DockPanel.Dock="Left" Style="{StaticResource Small}"
                       Margin="14,0,0,0" VerticalAlignment="Center" Text="—" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" Click="OnRefresh" />
        </DockPanel>

        <!-- 心情卡 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="MoodLabel" Text="—" FontSize="34" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock x:Name="MoodWhy" Style="{StaticResource Small}" Margin="0,8,0,0"
                               TextWrapping="Wrap" Text="—" />
                    <TextBlock x:Name="MoodHint" Style="{StaticResource Small}" Margin="0,10,0,0"
                               TextWrapping="Wrap" Text="心情会自己慢慢回落，被夸、被哄会涨，被骂会掉；面板只是看，不用手动调。" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="心情" Style="{StaticResource Label}" />
                        <TextBlock x:Name="ValenceText" DockPanel.Dock="Right" Style="{StaticResource Small}" Text="—" />
                    </DockPanel>
                    <ProgressBar x:Name="ValenceBar" Height="7" Minimum="0" Maximum="100" Margin="0,5,0,14"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface3}" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="精力" Style="{StaticResource Label}" />
                        <TextBlock x:Name="EnergyText" DockPanel.Dock="Right" Style="{StaticResource Small}" Text="—" />
                    </DockPanel>
                    <ProgressBar x:Name="EnergyBar" Height="7" Minimum="0" Maximum="100" Margin="0,5,0,0"
                                 Foreground="{DynamicResource Ok}" Background="{DynamicResource Surface3}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 联系人 -->
        <DockPanel Grid.Row="2" Margin="0,20,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="她对每个人的印象" Style="{StaticResource H2}" VerticalAlignment="Center" />
            <TextBlock x:Name="PeopleEmpty" DockPanel.Dock="Right" Style="{StaticResource Small}" Text="" VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PeopleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="14,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource Text}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Tier}" Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ClosenessText}" Style="{StaticResource Small}" />
                                    <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Closeness, Mode=OneWay}"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface3}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TrustText}" Style="{StaticResource Small}" />
                                    <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Trust, Mode=OneWay}"
                                                 Foreground="{DynamicResource Ok}" Background="{DynamicResource Surface3}" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Extra}" Style="{StaticResource Small}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
