<UserControl x:Class="WhaleLauncher.Views.YxnChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="本地回话" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <TextBlock x:Name="UpdatedText" DockPanel.Dock="Left" Style="{StaticResource Small}"
                       Margin="14,0,0,0" VerticalAlignment="Center" Text="—" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" Click="OnRefresh" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 开关与节奏 -->
                <Border Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="开关" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Text="关掉 = 完全走 DeepSeek；降级兜底 = DeepSeek 失败/超时才用本地词库；按概率 = 一部分消息直接由本地词库接（模拟“她随手打字”）。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模式" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="ModeBox" SelectionChanged="OnModeChanged">
                                <ComboBoxItem Content="关闭" Tag="off" />
                                <ComboBoxItem Content="降级兜底" Tag="fallback" />
                                <ComboBoxItem Content="按概率接管" Tag="probabilistic" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" x:Name="ModeHint" Style="{StaticResource Small}" VerticalAlignment="Center" Text="" />
                        </Grid>

                        <DockPanel Margin="0,14,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="接管概率" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" x:Name="ProbText" Style="{StaticResource Small}" Text="25%" VerticalAlignment="Center" />
                        </DockPanel>
                        <Slider x:Name="ProbSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="OnProbChanged" Margin="0,4,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="读延迟下限（秒）" Style="{StaticResource Small}" />
                                <TextBox x:Name="DelayMinBox" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="读延迟上限（秒）" Style="{StaticResource Small}" />
                                <TextBox x:Name="DelayMaxBox" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="打字（毫秒/字）" Style="{StaticResource Small}" />
                                <TextBox x:Name="TypingBox" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="最长等待（秒）" Style="{StaticResource Small}" />
                                <TextBox x:Name="MaxDelayBox" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="最低空闲内存（MB）" Style="{StaticResource Small}" />
                                <TextBox x:Name="RamBox" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,16,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Left" x:Name="BtnSave" Content="保存" Style="{StaticResource Primary}" Click="OnSave" />
                            <TextBlock x:Name="SaveText" DockPanel.Dock="Left" Style="{StaticResource Small}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Text="" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 词库 -->
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="词库" Style="{StaticResource H2}" />
                            <TextBlock DockPanel.Dock="Right" x:Name="PoolText" Style="{StaticResource Small}" Text="—" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Small}" Margin="0,6,0,10" TextWrapping="Wrap"
                                   Text="勾掉某个桶 = 那个话题不再用词库接。词条越多越像她；刚学到的会排后面。" />
                        <ItemsControl x:Name="BucketList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" x:Name="OffBox" IsChecked="{Binding Off, Mode=OneWay}"
                                                  Click="OnBucketToggle" DataContext="{Binding}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource Text}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Small}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding WeightText}" Style="{StaticResource Small}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Example}" Style="{StaticResource Small}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 本地模型 -->
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="本地模型（兜底）" Style="{StaticResource H2}" />
                            <TextBlock DockPanel.Dock="Right" x:Name="ModelStateText" Style="{StaticResource Small}" Text="—" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Small}" Margin="0,6,0,10" TextWrapping="Wrap"
                                   Text="填一个 llama.cpp 的 exe 和 .gguf 模型路径；DeepSeek 不通时用它生成，内存不够会自动跳过。留空则只用词库。" />
                        <CheckBox x:Name="ModelEnabledBox" Content="启用本地模型" Foreground="{DynamicResource Text}" Margin="0,0,0,10" />
                        <TextBlock Text="llama-cli 路径" Style="{StaticResource Small}" />
                        <TextBox x:Name="ModelCmdBox" Margin="0,4,0,10" />
                        <TextBlock Text="模型文件路径（.gguf）" Style="{StaticResource Small}" />
                        <TextBox x:Name="ModelPathBox" Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="最多生成 token" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ModelTokensBox" Width="90" />
                        </StackPanel>
                        <Button x:Name="BtnSaveModel" Content="保存模型设置" Style="{StaticResource Ghost}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnSaveModel" />
                    </StackPanel>
                </Border>

                <!-- 本地模型手动调试 -->
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="本地模型 · 手动试一句" Style="{StaticResource H2}" />
                            <TextBlock DockPanel.Dock="Right" x:Name="LocalTestState" Style="{StaticResource Small}" Text="—" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Small}" Margin="0,6,0,10" TextWrapping="Wrap"
                                   Text="不经过 DeepSeek，直接让本地模型按「对方说」回一句，用来确认兜底链路是否正常。" />
                        <TextBlock Text="对方说" Style="{StaticResource Small}" />
                        <TextBox x:Name="LocalTestInput" Margin="0,4,0,10" Text="今天好累啊，不想上班" />
                        <TextBlock Text="额外要求（可选）" Style="{StaticResource Small}" />
                        <TextBox x:Name="LocalTestInstruction" Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnLocalTest" Content="让本地模型回一句" Style="{StaticResource Primary}" Click="OnLocalTest" />
                            <Button x:Name="BtnLocalTestSend" Content="生成并发到文件传输助手" Style="{StaticResource Ghost}" Margin="10,0,0,0" Click="OnLocalTestSend" />
                            <Button x:Name="BtnLocalTestCopy" Content="复制" Style="{StaticResource Ghost}" Margin="10,0,0,0" Click="OnLocalTestCopy" />
                        </StackPanel>
                        <TextBox x:Name="LocalTestOutput" Margin="0,12,0,0" Height="72" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 本地回复统计 -->
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="本地回复统计" Style="{StaticResource H2}" />
                            <TextBlock DockPanel.Dock="Right" x:Name="ReplyStatsText" Style="{StaticResource Small}" Text="—" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Small}" Margin="0,6,0,10" TextWrapping="Wrap"
                                   Text="只统计「本地模型」和「词库」接的话，DeepSeek 回复不算。模型 = 用本地大模型生成；词库 = 从学到的句子里抽。" />
                        <ItemsControl x:Name="ReplyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,3" Style="{StaticResource Small}" Text="{Binding Line}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="最近活动" Style="{StaticResource H2}" />
                            <TextBlock DockPanel.Dock="Right" x:Name="DirText" Style="{StaticResource Small}" Text="" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox x:Name="LogBox" Margin="0,10,0,0" Height="180" IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
